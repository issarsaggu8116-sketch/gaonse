# Gaon Se Customer App - Environment Variables Template

# Production Configuration:
EXPO_PUBLIC_API_URL=https://api.gaonse.in

# Local Development Configuration (uncomment if testing locally):
# Web / Browser:
# EXPO_PUBLIC_API_URL=http://localhost:4000

# Physical Device (Expo Go on Wi-Fi):
# EXPO_PUBLIC_API_URL=http://<YOUR_LOCAL_IP>:4000

# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
